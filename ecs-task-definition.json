{
  "family": "clouddeploy-task",
  "executionRoleArn": "arm:aws:iam::234831149412:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "clouddeploy-container",
      "image": "234831149412.dkr.ecr.us-east-1.amazonaws.com/clouddeploy-app:v1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}